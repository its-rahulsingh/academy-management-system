# Copy to .env for local runs, or set these in Render -> Environment. Never commit real values.

# Required
ConnectionStrings__AcademyDb=Host=localhost;Port=5432;Database=academyflow;Username=postgres;Password=CHANGE_ME
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARACTERS

# Public address of the site, used in emailed links
App__PublicBaseUrl=https://your-app.onrender.com

# Email (optional). Until set, emails are written to the server log instead of sent.
Email__Host=
Email__Port=587
Email__Username=
Email__Password=
Email__FromAddress=
Email__FromName=AcademyFlow

# Razorpay (optional). Until set, academies pay offline and the owner marks invoices paid.
Razorpay__KeyId=
Razorpay__KeySecret=
Razorpay__WebhookSecret=

# Subscription rules (optional; defaults shown)
Subscription__GraceDays=7
Subscription__InvoiceLeadDays=7
Subscription__DefaultTrialDays=14
